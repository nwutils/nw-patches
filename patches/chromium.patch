+  [mediator_ setConsumer:mock_consumer];
+
+  mediator_.active = NO;
+
+  OCMExpect(
+      [mock_consumer setPlaceholderType:LocationBarPlaceholderType::kNone]);
+  [mediator_ locationUpdated];
+  EXPECT_OCMOCK_VERIFY(mock_consumer);
+}
