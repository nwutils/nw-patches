+    base::ListValue args;
+    if (user_force)
+      args.Append("quit");
+    ExtensionWebContentsObserver::GetForWebContents(web_contents())
+      ->GetLocalFrame(rfh)
+      ->MessageInvoke(
+                      listener_extension_id, "nw.Window",
+                      "onClose", std::move(args));
+    return false;
+  }
+  return true;
