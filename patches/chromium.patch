+  FileList* impl = MakeGarbageCollected<FileList>();
+  v8::Local<v8::Object> v8_wrapper = impl->AssociateWithWrapper(isolate, V8FileList::GetWrapperTypeInfo(), v8_receiver);
+  bindings::V8SetReturnValue(args, v8_wrapper);
