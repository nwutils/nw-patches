+              mojo::PendingReceiver<blink::mojom::FileSystemAccessObserver>
+                  receiver) {
+            observe_status = result->status;
+            run_loop.Quit();
+          }));
+  run_loop.Run();
+
+  EXPECT_EQ(observe_status,
+            blink::mojom::FileSystemAccessStatus::kSecurityError);
